# ─── Registration backend ────────────────────────────────────────────────────
# Deployed Google Apps Script Web App URL (must end in /exec).
# See project-docs/apps-script-backend.gs for deployment steps.
#
# On hosts that reject the REACT_APP_ prefix, set the bare name instead
# (GOOGLE_SCRIPT_URL); scripts/setup-env.js bridges it at build time.
REACT_APP_GOOGLE_SCRIPT_URL=

# Payments go to the college's BillDesk collect page, shown on the form as a QR
# plus a plain link. Both are hard-coded in src/config/registrationConfig.js —
# there is no UPI ID and no payment env var any more.

# ─── Optional: EmailJS (instant "we received your registration" mail) ────────
# Leave blank to skip — verified/rejected mails are sent by Apps Script anyway.
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_CONFIRMATION_TEMPLATE_ID=
REACT_APP_EMAILJS_VERIFIED_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=
